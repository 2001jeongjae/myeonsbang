rules_version = '2';

// 면스방 보안 규칙
// - 모집 글은 누구나 읽는다 (공개 게시판).
// - 글은 익명 로그인한 사람이 자기 이름(hostId)으로만 만든다.
// - 방장은 마감, 수락·거절, 내보내기, 글 지우기를 할 수 있다.
// - 다른 사람은 참가자·신청자 목록에서 '자기 칸'만 바꿀 수 있다 (참가, 신청, 신청 취소, 나가기).
// - 거절되거나 내보내진 사람은 같은 글에 다시 들어올 수 없다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function str(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }

    function validEntry(e) {
      return e is map
        && e.keys().hasAll(['nick', 'job', 'jobKey', 'intro', 'at'])
        && e.keys().hasOnly(['nick', 'job', 'jobKey', 'intro', 'at', 'role', 'status'])
        && str(e.nick, 2, 12) && str(e.job, 1, 20) && str(e.jobKey, 1, 30) && str(e.intro, 0, 60)
        && e.at is int;
    }

    // 같은 직무끼리: 글의 직무와 같아야 한다. 다른 직무끼리: 적어도 방장 직무와는 달라야 한다.
    function jobAllowed(before, e) {
      return (before.jobRule != 'same' || e.jobKey == before.jobKey)
        && (before.jobRule != 'diverse' || e.jobKey != before.jobKey);
    }

    function validNewPost() {
      let d = request.resource.data;
      let uid = request.auth.uid;
      let fields = ['company', 'job', 'jobKey', 'stage', 'interviewDate', 'mode', 'place', 'capacity',
                    'jobRule', 'joinMode', 'intro', 'hostId', 'closed', 'createdAt', 'members', 'applicants'];
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.hostId == uid
        && str(d.company, 1, 30) && str(d.job, 1, 20) && str(d.jobKey, 1, 30)
        && d.stage in ['1차 실무', '2차 임원·인성', 'PT', '토론', '기타']
        && (d.interviewDate == null || (d.interviewDate is string && d.interviewDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.mode in ['online', 'offline'] && str(d.place, 0, 40)
        && d.capacity is int && d.capacity >= 2 && d.capacity <= 6
        && d.jobRule in ['same', 'diverse', 'any'] && d.joinMode in ['instant', 'approve']
        && str(d.intro, 0, 300)
        && d.closed == false
        && d.createdAt is int && math.abs(d.createdAt - request.time.toMillis()) < 600000
        && d.members is map && d.members.size() == 1 && d.members.keys().hasOnly([uid])
        && validEntry(d.members[uid]) && d.members[uid].role == 'host'
        && d.applicants is map && d.applicants.size() == 0;
    }

    function onlyListsChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validHostUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let host = before.hostId;
      return onlyListsChanged(['members', 'applicants', 'closed'])
        && after.closed is bool
        && after.members is map && after.applicants is map
        && after.members.size() <= before.capacity
        && host in after.members && after.members[host] == before.members[host]
        && after.applicants.size() <= 60;
    }

    function joins(uid, before, after) {
      return before.joinMode == 'instant' && before.closed == false
        && !(uid in before.members) && uid in after.members
        && validEntry(after.members[uid]) && after.members[uid].role == 'member'
        && jobAllowed(before, after.members[uid])
        && after.members.size() <= before.capacity
        && !(uid in after.applicants);
    }

    function applies(uid, before, after) {
      return before.joinMode == 'approve' && before.closed == false
        && !(uid in before.members) && !(uid in after.members)
        && uid in after.applicants
        && validEntry(after.applicants[uid]) && after.applicants[uid].status == 'pending'
        && jobAllowed(before, after.applicants[uid])
        && after.applicants.size() <= 60;
    }

    function cancels(uid, before, after) {
      return uid in before.applicants && before.applicants[uid].status == 'pending'
        && !(uid in after.applicants)
        && !(uid in before.members) && !(uid in after.members);
    }

    function leaves(uid, before, after) {
      return uid in before.members && before.members[uid].role != 'host'
        && !(uid in after.members)
        && after.applicants.diff(before.applicants).affectedKeys().size() == 0;
    }

    function validSelfUpdate() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      return onlyListsChanged(['members', 'applicants'])
        && after.members is map && after.applicants is map
        && after.members.diff(before.members).affectedKeys().hasOnly([uid])
        && after.applicants.diff(before.applicants).affectedKeys().hasOnly([uid])
        && !(uid in before.applicants && before.applicants[uid].status == 'rejected')
        && (joins(uid, before, after) || applies(uid, before, after)
            || cancels(uid, before, after) || leaves(uid, before, after));
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && validNewPost();
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
      allow update: if signedIn() && (
        (resource.data.hostId == request.auth.uid && validHostUpdate())
        || (resource.data.hostId != request.auth.uid && validSelfUpdate())
      );
    }
  }
}
